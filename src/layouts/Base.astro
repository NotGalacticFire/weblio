---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { site } from '../data/site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Path only, e.g. "/contact" — combined with site.url for the canonical. */
  path?: string;
  ogImage?: string;
}

const {
  title = site.title,
  description = site.description,
  path = Astro.url.pathname,
  ogImage = '/og.png',
} = Astro.props;

const canonical = new URL(path === '/' ? '/' : path.replace(/\/$/, ''), site.url).href;
const ogUrl = new URL(ogImage, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  description: site.description,
  email: site.email,
  founder: { '@type': 'Person', name: site.person },
  areaServed: 'Worldwide',
  serviceType: [
    'Web design',
    'Web development',
    'Website redesign',
    'Web performance and accessibility',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Weblio — websites that survive a second look" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <meta name="theme-color" content="#f2efe9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14110e" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* The two faces that set the first screen. The mono is font-display:
        optional and never blocks, so it is deliberately not preloaded. */}
    <link rel="preload" href="/fonts/fraunces-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-var.woff2" as="font" type="font/woff2" crossorigin />

    {/* Set before first paint so reveal states never flash for no-JS users. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    {/* The sheet the whole site is printed on. */}
    <div class="sheet-grid" aria-hidden="true" data-sheet-grid>
      <div class="sheet-grid__inner">
        {Array.from({ length: 12 }).map(() => <div class="sheet-grid__col" />)}
      </div>
    </div>

    <Nav />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/motion';

      // Reveal the printed grid once styles have settled, so it fades in with
      // the page rather than snapping in during load.
      const grid = document.querySelector('[data-sheet-grid]');
      if (grid) requestAnimationFrame(() => grid.setAttribute('data-ready', ''));
    </script>
  </body>
</html>
